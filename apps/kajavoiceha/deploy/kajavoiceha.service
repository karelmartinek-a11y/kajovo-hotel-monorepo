[Unit]
Description=KajaVoiceHA smart technology MCP gateway
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=kajavoiceha
Group=www-data
SupplementaryGroups=kajavoiceha
WorkingDirectory=/opt/kajavoiceha/current
ExecStart=/opt/kajavoiceha/current/bin/kajavoiceha
Environment=KAJA_CATALOG_FILE=/etc/kajavoiceha/catalog.json
Environment=KAJA_BACKEND_URL=http://192.168.124.10
Environment=KAJA_JOURNAL_FILE=/var/lib/kajavoiceha/journal.json
Environment=KAJA_SOCKET=/run/kajavoiceha/mcp.sock
Environment=KAJA_PUBLIC_HOST=apimcpkajavoiceha.hcasc.cz
Environment=GOMEMLIMIT=160MiB
LoadCredential=ha-token:/etc/hotel-smart-technologies/ha-token
LoadCredential=clients.json:/etc/kajavoiceha/clients.json
RuntimeDirectory=kajavoiceha
RuntimeDirectoryMode=0750
StateDirectory=kajavoiceha
StateDirectoryMode=0700
UMask=0007
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
MemoryHigh=192M
MemoryMax=256M
CPUQuota=50%
TasksMax=64
LimitNOFILE=4096
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ReadWritePaths=/var/lib/kajavoiceha /run/kajavoiceha
IPAddressDeny=any
IPAddressAllow=192.168.124.10

[Install]
WantedBy=multi-user.target
