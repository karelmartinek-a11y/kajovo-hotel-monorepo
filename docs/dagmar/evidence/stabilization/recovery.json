{
  "postgres_image": "16.4-alpine",
  "api_image": "kajovo-api-stability",
  "backup_schema": "dagmar",
  "migration": {
    "version": 1,
    "already_applied": true
  },
  "recovery": {
    "post_migration_restore": true,
    "new_write_durable": true,
    "original_receipt_replayed": true,
    "provider_key_decrypt": true,
    "separate_diagnostic_key_restore": true,
    "schema_version": 1
  },
  "legacy_source_untouched": true,
  "old_stage_a_code_compatible": false,
  "rollback_requires_dagmar_schema_and_receipts": true
}
