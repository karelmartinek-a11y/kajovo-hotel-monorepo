# Prod-like defaults (safe placeholders)
POSTGRES_DB=kajovo_hotel
POSTGRES_USER=kajovo
POSTGRES_PASSWORD=change_me_prod

KAJOVO_API_APP_NAME=KájovoHotel API
KAJOVO_API_APP_VERSION=0.1.0
KAJOVO_API_ENVIRONMENT=production
KAJOVO_API_DATABASE_URL=postgresql+psycopg://kajovo:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Optional host overrides
WEB_PORT=8080
API_PORT=8202
COMPOSE_PROJECT_NAME=kajovo-prod

# Admin voice memory: automatic curation is an account setting; explicit memory is always available.
VOICE_MEMORY_CONTEXT_MAX_TOKENS=2000
KAJOVO_API_VOICE_MEMORY_CURATOR_MODEL=gpt-4.1-mini-2025-04-14
KAJOVO_API_VOICE_MEMORY_BATCH_SECONDS=90
KAJOVO_API_VOICE_MEMORY_MAX_CALLS_PER_HOUR=40
