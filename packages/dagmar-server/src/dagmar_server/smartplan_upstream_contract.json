{
  "contract": "SMARTPLAN-UPSTREAM",
  "version": "1.0",
  "server_release_version": "2.1.18",
  "api_version": 2,
  "base_url": "https://apimcpkajavoiceha.hcasc.cz",
  "mcp": {
    "endpoint": "/mcp",
    "tool": "smart_technologie",
    "additive_operations": [
      "smartplan_handoff",
      "solar_calendar"
    ],
    "selection_ttl_seconds": 1800,
    "handoff_ticket_ttl_seconds": 120,
    "context_ttl_seconds": 600,
    "handoff_targets_max": 64,
    "handoff_argument_schema": {
      "additionalProperties": false,
      "description": "smartplan_handoff: ověřené předání nebo odvolání delegace.",
      "properties": {
        "action": {
          "description": "issue vyžaduje aktuální selection_id; revoke vlastní grant_id.",
          "enum": [
            "issue",
            "revoke"
          ],
          "type": "string"
        },
        "context_id": {
          "description": "Kontext SmartPlanu; nevymýšlet.",
          "type": "string"
        },
        "grant_id": {
          "description": "Vlastní delegace k odvolání, pouze revoke.",
          "type": "string"
        },
        "targets": {
          "description": "Funkce a čtení z describe téhož výběru.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "function": {
                "description": "Přesné cNN/rNN komponenty.",
                "type": "string"
              },
              "kind": {
                "description": "cNN ovládání, rNN čtení.",
                "enum": [
                  "control",
                  "reading"
                ],
                "type": "string"
              },
              "row": {
                "description": "Řádek ověřeného výběru.",
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "row",
              "kind",
              "function"
            ],
            "type": "object"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    "solar_argument_schema": {
      "additionalProperties": false,
      "description": "solar_calendar: výpočet konkrétního dne; next_* znamená následující výskyt.",
      "properties": {
        "date": {
          "description": "Konkrétní den Europe/Prague, 2000–2100.",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "type": "string"
        },
        "offset_seconds": {
          "description": "Sekundy v UTC: -18000 před úsvitem, 10800 po západu. Zachová datum přes půlnoc i DST.",
          "maximum": 604800,
          "minimum": -604800,
          "type": "integer"
        }
      },
      "required": [
        "date"
      ],
      "type": "object"
    }
  },
  "authentication": {
    "service": "dedicated revocable Bearer header; not accepted by /mcp",
    "parent": "authenticated upstream OAuth grant or legacy account, never model user_id",
    "service_permissions": [
      "discover",
      "handoff",
      "read",
      "control",
      "events"
    ],
    "scope_rule": "intersection(service permissions, exact delegation, live parent rights, approved catalog)",
    "owner_binding": "SmartPlan backend derives from authenticated local account; Kaja binds to verified MCP subject via context+claim+ticket",
    "forward_user_oauth_token": false,
    "credentials_in_model": false,
    "host_https_origin_guards": true
  },
  "endpoints": {
    "/smartplan/v1/contexts": {
      "method": "POST",
      "permission": "handoff",
      "request_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner_binding"
        ],
        "properties": {
          "owner_binding": {
            "type": "string",
            "minLength": 16,
            "maxLength": 128
          }
        }
      },
      "response_content_type": "application/json",
      "response_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "context_id",
          "claim_secret",
          "expires_at"
        ],
        "properties": {
          "context_id": {
            "type": "string"
          },
          "claim_secret": {
            "type": "string"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "/smartplan/v1/redeem": {
      "method": "POST",
      "permission": "handoff",
      "request_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "context_id",
          "claim_secret",
          "ticket"
        ],
        "properties": {
          "context_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "claim_secret": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "ticket": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "response_content_type": "application/json",
      "response_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "grant_id",
          "owner_ref",
          "owner_binding",
          "targets",
          "expires_at"
        ],
        "properties": {
          "version": {
            "const": "1.0"
          },
          "grant_id": {
            "type": "string"
          },
          "owner_ref": {
            "type": "string"
          },
          "owner_binding": {
            "type": "string"
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "/smartplan/v1/describe": {
      "method": "POST",
      "permission": "read",
      "request_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "grant_id",
          "owner_ref",
          "owner_binding",
          "targets"
        ],
        "properties": {
          "grant_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "owner_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "owner_binding": {
            "type": "string",
            "minLength": 16,
            "maxLength": 128
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      },
      "response_content_type": "application/json",
      "response_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "catalog_revision",
          "targets",
          "events_transport",
          "lease_seconds"
        ],
        "properties": {
          "version": {
            "const": "1.0"
          },
          "catalog_revision": {
            "type": "string"
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ref",
                "kind",
                "name",
                "location",
                "semantic_revision",
                "available",
                "unit"
              ],
              "properties": {
                "ref": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "device",
                    "component",
                    "control",
                    "reading"
                  ]
                },
                "name": {
                  "type": "string"
                },
                "location": {
                  "type": "string"
                },
                "semantic_revision": {
                  "type": "string"
                },
                "available": {
                  "type": "boolean"
                },
                "unit": {
                  "type": "string"
                },
                "parameters": {
                  "type": "object"
                },
                "device_ref": {
                  "type": "string"
                },
                "component_ref": {
                  "type": "string"
                }
              }
            }
          },
          "events_transport": {
            "const": "filtered_sse"
          },
          "lease_seconds": {
            "const": 60
          }
        }
      }
    },
    "/smartplan/v1/read": {
      "method": "POST",
      "permission": "read",
      "request_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "grant_id",
          "owner_ref",
