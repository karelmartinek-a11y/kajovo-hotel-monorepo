            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "owner_binding": {
            "type": "string",
            "minLength": 16,
            "maxLength": 128
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      },
      "response_content_type": "application/json",
      "response_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "catalog_revision",
          "readings"
        ],
        "properties": {
          "version": {
            "const": "1.0"
          },
          "catalog_revision": {
            "type": "string"
          },
          "readings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "ref",
                "value",
                "unit",
                "available",
                "observed_at_utc",
                "source_updated_at_utc",
                "source",
                "semantic_revision"
              ],
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "value": {},
                "unit": {
                  "type": "string"
                },
                "available": {
                  "type": "boolean"
                },
                "observed_at_utc": {
                  "type": "string",
                  "format": "date-time"
                },
                "source_updated_at_utc": {
                  "type": "string"
                },
                "source": {
                  "const": "ha_state"
                },
                "semantic_revision": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            }
          }
        }
      }
    },
    "/smartplan/v1/control": {
      "method": "POST",
      "permission": "control",
      "request_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "grant_id",
          "owner_ref",
          "owner_binding",
          "target",
          "request_id"
        ],
        "properties": {
          "grant_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "owner_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "owner_binding": {
            "type": "string",
            "minLength": 16,
            "maxLength": 128
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "parameters": {
            "type": "object"
          },
          "request_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,128}$"
          }
        }
      },
      "response_content_type": "application/json",
      "response_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
