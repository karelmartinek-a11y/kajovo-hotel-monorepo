    "/smartplan/v1/solar_calendar": {
      "method": "POST",
      "permission": "read",
      "request_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "grant_id",
          "owner_ref",
          "owner_binding",
          "targets",
          "solar"
        ],
        "properties": {
          "grant_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "owner_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "owner_binding": {
            "type": "string",
            "minLength": 16,
            "maxLength": 128
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "solar": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "date"
            ],
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "offset_seconds": {
                "type": "integer",
                "minimum": -604800,
                "maximum": 604800
              }
            }
          }
        }
      },
      "response_content_type": "application/json",
      "response_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "solar",
          "results",
          "is_error"
        ],
        "properties": {
          "version": {
            "const": "1.0"
          },
          "solar": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "date",
                  "offset_seconds",
                  "offset_basis",
                  "observer",
                  "events"
                ],
                "properties": {
                  "date": {
                    "type": "string"
                  },
                  "offset_seconds": {
                    "type": "integer"
                  },
                  "offset_basis": {
                    "const": "elapsed_seconds_in_UTC"
                  },
                  "observer": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "latitude",
                      "longitude",
                      "timezone",
                      "elevation",
                      "elevation_verified"
                    ],
                    "properties": {
                      "latitude": {
                        "type": "number"
                      },
                      "longitude": {
                        "type": "number"
                      },
                      "timezone": {
                        "type": "string"
                      },
                      "elevation": {
                        "type": "number"
                      },
                      "elevation_verified": {
                        "type": "boolean"
                      }
                    }
                  },
                  "events": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "event",
                        "event_date",
                        "timezone",
                        "source",
                        "available",
                        "elevation_verified"
                      ],
                      "properties": {
                        "event": {
                          "enum": [
                            "dawn",
                            "rising",
                            "setting",
                            "dusk"
                          ]
                        },
                        "event_date": {
                          "type": "string"
                        },
                        "timezone": {
                          "type": "string"
                        },
                        "source": {
                          "const": "calculated_astral_3.2"
                        },
                        "available": {
                          "type": "boolean"
                        },
                        "elevation_verified": {
                          "type": "boolean"
                        },
                        "utc": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "local": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "shifted_utc": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "shifted_local": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "reason": {
                          "const": "no_event_on_date"
                        }
                      }
                    }
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status"
              ],
              "properties": {
